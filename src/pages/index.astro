---
// The site's root. It is the English landing; a reader whose browser speaks Portuguese, or who read
// the site in Portuguese before, is taken to the Portuguese one before anything is painted. Search
// engines are told the page's own address is /en/.
import Site from "../layouts/Site.astro";
import { App } from "../site/App";
import { routeAt } from "../site/routes";
import { siteData } from "../site/seo";

const model = routeAt("/");
const choose = `try{var l=localStorage.getItem("dan.rio-lang")||(/^pt\\b/i.test(navigator.language||"")?"pt":"en");if(l==="pt")location.replace("/pt/")}catch(e){}`;
---
<Site title={model.meta.title} description={model.meta.description} lang="en" path="/" canonical="/en/" alternates={model.meta.alternates} data={siteData("en", model.meta.description)}>
  <script is:inline slot="head" set:html={choose}></script>
  <App client:load initial={model} />
</Site>
