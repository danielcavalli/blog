---
import Site from "../../../layouts/Site.astro";
import { posts, postUrl, type Lang, type Post } from "../../../content/documents";
import { App } from "../../../site/App";
import { routeAt } from "../../../site/routes";
import { postData } from "../../../site/seo";

export function getStaticPaths() {
  return posts().flatMap((post) => (Object.keys(post.in) as Lang[]).map((lang) => ({ params: { lang, slug: post.slug }, props: { post, lang } })));
}

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const path = postUrl(post, lang);
const model = routeAt(path);
const tags = post.in[lang]!.tags;
---
<Site
  title={model.meta.title}
  description={model.meta.description}
  lang={lang}
  path={path}
  alternates={model.meta.alternates}
  article={{ published: post.date, updated: post.updated, tags }}
  data={postData(post, lang, path)}
  markdown={`${path}.md`}
>
  <App client:load initial={model} />
</Site>
