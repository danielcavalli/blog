---
import Site from "../../../layouts/Site.astro";
import { App } from "../../../site/App";
import { routeAt } from "../../../site/routes";
import { blogData } from "../../../site/seo";
import type { Lang } from "../../../site/words";

export const getStaticPaths = () => [{ params: { lang: "en" } }, { params: { lang: "pt" } }];

const lang = Astro.params.lang as Lang;
const model = routeAt(`/${lang}/blog/`);
---
<Site title={model.meta.title} description={model.meta.description} lang={lang} path={model.meta.path} alternates={model.meta.alternates} data={blogData(lang, model.meta.description)}>
  <App client:load initial={model} />
</Site>
