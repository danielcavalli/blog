{
  "name": "dan-rio",
  "private": true,
  "type": "module",
  "description": "dan.rio: Daniel Cavalli's blog",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/sync-media.mjs && astro dev",
    "build": "node tools/sync-media.mjs && astro build",
    "preview": "astro preview",
    "prepare": "node tools/git/setup.mjs",
    "test": "node --test \"tools/**/*.test.*\"",
    "conversations:check": "node tools/git/conversations.mjs check",
    "conversations:refresh": "node tools/git/conversations.mjs refresh",
    "check": "astro sync && tsc --noEmit -p tsconfig.json",
    "deploy": "npm run build && cf deploy dist",
    "translate": "node tools/translate/cli.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@mare-rio/design-system": "1.1.0",
    "astro": "^7.4.13",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "image-size": "^2.2.0",
    "pele": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "cf": "^1.0.0-rc.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
